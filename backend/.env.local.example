# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored; .env.local.example is committed as a template.

gemnai_key=AIzaSy...

# Chroma vector store
CHROMA_PERSIST_DIR=./chroma_data
COLLECTION_NAME=rag_documents

# Indexing pipeline
INDEX_CHUNK_SIZE=500
INDEX_CHUNK_OVERLAP=50
INDEX_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Chat / retrieval pipeline
CHAT_RETRIEVAL_TOP_K=4
